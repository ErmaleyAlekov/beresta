<Project Sdk="Microsoft.NET.Sdk">

  <!--
      Берёста для .NET — обёртка над Си-интерфейсом через P/Invoke.

      Нативная библиотека попадает в runtimes/<rid>/native/ при сборке ядра:
          make CSHARP=1   или   cmake -DBERESTA_BUILD_CSHARP=ON
      Это стандартная раскладка NuGet: в пакете (dotnet pack) .NET сам
      выберет бинарник нужной платформы. При ссылке на проект файлы
      копируются в выходной каталог, а NativeResolver находит их там.

      netstandard2.1 — для любых сред (.NET Core 3+, Mono, Unity);
      net9.0 — дополнительно собственный поиск бинарника (NativeLibrary).

      Beresta for .NET is a wrapper over the C interface through P/Invoke.

      The native library lands in runtimes/<rid>/native/ when the core is built:
          make CSHARP=1   or   cmake -DBERESTA_BUILD_CSHARP=ON
      This is the standard NuGet layout: in a package (dotnet pack) .NET picks
      the binary of the right platform itself. With a project reference the files
      are copied to the output directory, and NativeResolver finds them there.

      netstandard2.1 is for any runtime (.NET Core 3+, Mono, Unity);
      net9.0 adds its own binary lookup (NativeLibrary).
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Beresta</RootNamespace>
    <!-- Не "Beresta": на Windows Beresta.dll и нативная beresta.dll — один и
         тот же файл (регистр не различается), а при публикации приложения
         .NET кладёт нативные библиотеки в тот же каталог, что и сборки

        Not "Beresta": on Windows Beresta.dll and the native beresta.dll are the same
        file (case is ignored), and when an application is published .NET puts native
        libraries into the same directory as the assemblies
    -->
    <AssemblyName>Beresta.NET</AssemblyName>
    <Version>2.1.2</Version>
    <PackageId>Beresta</PackageId>
    <Description>Берёста — DOM-библиотека XML на C++17: DOM, XPath 1.0, XML Schema, DTD (обёртка P/Invoke)</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ErmaleyAlekov/beresta</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ErmaleyAlekov/beresta.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Нативные библиотеки всех собранных платформ: в пакет и в выходной каталог / Native libraries of all built platforms: into the package and the output directory -->
  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <!-- Текст лицензии из корня репозитория — в корень пакета / The license text from the repository root goes to the package root -->
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
