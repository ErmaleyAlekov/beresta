<?xml version="1.0" encoding="UTF-8"?>
<!--
    Берёста для Java — Maven-проект обёртки над Си-интерфейсом через
    Project Panama (Foreign Function & Memory API, Java 22+). JNI не нужен.

    Нативная библиотека попадает в src/main/resources/natives/<os>-<arch>/
    при сборке ядра с флагом Java:
        make JAVA=1
        или CMake с опцией -DBERESTA_BUILD_JAVA=ON (затем обычная сборка build)
    После этого:  mvn -f bindings/java/pom.xml package
    Публикация в Maven Central (её делает release.yml по тегу):
        mvn -f bindings/java/pom.xml -P central deploy
    Чтобы получить один jar для всех платформ, соберите ядро на каждой ОС
    (или в CI-матрице) — каждая сборка добавит свою папку natives/<os>-<arch>.

    При запуске приложения разрешите нативный доступ ключом JVM
    enable-native-access=ALL-UNNAMED (без него Java 22+ печатает
    предупреждение; в docs/bindings.md показана точная команда).

    Beresta for Java is a Maven project of the wrapper over the C interface through
    Project Panama (Foreign Function & Memory API, Java 22+). JNI is not needed.

    The native library lands in src/main/resources/natives/<os>-<arch>/
    when the core is built with the Java flag:
        make JAVA=1
        or CMake with -DBERESTA_BUILD_JAVA=ON (then an ordinary build)
    After that:  mvn -f bindings/java/pom.xml package
    Publishing to Maven Central (release.yml does it from a tag):
        mvn -f bindings/java/pom.xml -P central deploy
    To get one jar for all platforms, build the core on each OS
    (or in a CI matrix) — each build adds its own natives/<os>-<arch> folder.

    When running the application, allow native access with the JVM option
    enable-native-access=ALL-UNNAMED (without it Java 22+ prints a
    warning; docs/bindings.en.md shows the exact command).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Namespace io.github.<логин> Maven Central подтверждает по входу через GitHub;
         Java-пакет и имя модуля остаются org.beresta
         The io.github.<login> namespace is verified by Maven Central through the GitHub sign-in;
         the Java package and the module name stay org.beresta -->
    <groupId>io.github.ermaleyalekov</groupId>
    <artifactId>beresta</artifactId>
    <version>2.1.3</version>
    <packaging>jar</packaging>

    <name>Beresta</name>
    <description>Beresta: a C++17 XML library (DOM, XPath 1.0, XML Schema, DTD) for Java through Project Panama. Берёста: XML-библиотека на C++17 для Java через Project Panama.</description>
    <url>https://github.com/ErmaleyAlekov/beresta</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- Разработчики и исходники обязательны для Maven Central / Developers and sources are required by Maven Central -->
    <developers>
        <developer>
            <id>ermaleyalekov</id>
            <name>Ermaley Alekov</name>
            <email>ermaley.alekov@yandex.ru</email>
            <url>https://github.com/ErmaleyAlekov</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/ErmaleyAlekov/beresta.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ErmaleyAlekov/beresta.git</developerConnection>
        <url>https://github.com/ErmaleyAlekov/beresta</url>
    </scm>

    <properties>
        <maven.compiler.release>22</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- Зависимостей нет: только JDK 22+ и собственная нативная библиотека / No dependencies: only JDK 22+ and our own native library -->

    <build>
        <!-- Ресурсы по умолчанию (natives/) и текст лицензии из корня
             репозитория в META-INF/LICENSE: MIT требует, чтобы уведомление
             распространялось вместе с копиями программы

            Default resources (natives/) and the license text from the repository root
            into META-INF/LICENSE: MIT requires the notice to be distributed
            together with copies of the software
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../..</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- Двоичные файлы в ресурсах нельзя фильтровать как текст / Binary files in resources must not be filtered as text -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>dll</nonFilteredFileExtension>
                        <nonFilteredFileExtension>so</nonFilteredFileExtension>
                        <nonFilteredFileExtension>dylib</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Самопроверка — обычная программа (без JUnit), запускается
                 через make java-test или ctest; surefire её не ищет

                The self-test is an ordinary program (no JUnit), run through
                make java-test or ctest; surefire does not look for it
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.beresta</Automatic-Module-Name>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Профиль central — публикация в Maven Central: jar с исходниками и
        javadoc, подпись GPG всех файлов и выгрузка через Central Portal.
        Обычная сборка (mvn package) его не включает и ключ GPG не требует.
        Логин и пароль — токен пользователя Central Portal (server id
        "central" в settings.xml), пароль ключа GPG — переменная окружения
        MAVEN_GPG_PASSPHRASE; release.yml берёт всё это из секретов.

        The central profile is publishing to Maven Central: the sources and
        javadoc jars, a GPG signature of all files and the upload through the
        Central Portal. An ordinary build (mvn package) does not enable it and
        needs no GPG key. The login and password are a Central Portal user token
        (server id "central" in settings.xml), the GPG key passphrase is the
        MAVEN_GPG_PASSPHRASE environment variable; release.yml takes all of it from secrets.
    -->
    <profiles>
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <!-- Нативные бинарники — не исходники: в jar исходников только .java
                             Native binaries are not sources: the sources jar holds only .java -->
                        <configuration>
                            <excludeResources>true</excludeResources>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- doclint выключен: двуязычные комментарии — обычный текст, а не строгий HTML
                         doclint is off: bilingual comments are plain text, not strict HTML -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- loopback: пароль ключа берётся из переменной, без окна ввода
                         loopback: the key passphrase is taken from the variable, without a prompt window -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- autoPublish: после проверки Central публикует сам, без ручной кнопки.
                         Не ниже 0.12.0: старые версии кладут в бандл maven-metadata-local.xml от Maven 3.10,
                         и Central отвергает бандл ("content that does NOT have a .pom file")
                         autoPublish: after validation Central publishes by itself, without a manual button.
                         At least 0.12.0: older versions put maven-metadata-local.xml from Maven 3.10 into
                         the bundle, and Central rejects it ("content that does NOT have a .pom file") -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
