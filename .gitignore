# ============================================================================
#  Берёста (beresta) — исключения для Git
#  Beresta — Git exclusions
# ============================================================================

# ---- Любые каталоги, имя которых начинается с точки (на любом уровне) -------
# .vscode/, .idea/, .vs/, .cache/ и т.п. вместе со всем содержимым.
# Сам файл .gitignore — это файл, а не каталог, поэтому под правило не попадает.
# ---- Any directories whose name starts with a dot (at any level) ------------
# .vscode/, .idea/, .vs/, .cache/ and so on with all their content.
# The .gitignore itself is a file, not a directory, so the rule does not cover it.
.*/

# Исключение: workflow GitHub Actions (CI и релизы) обязаны попасть в репозиторий
# Exception: the GitHub Actions workflows (CI and releases) must go into the repository
!/.github/

# ---- Результаты сборки Makefile / Makefile build results --------------------
/obj/
/dep/
/bin/

# ---- Результаты сборки CMake / CMake build results --------------------------
/build/
/build-*/
/cmake-build-*/
/out/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json

# ---- Копии нативной библиотеки в обёртках (кладёт сборка) -------------------
# ---- Copies of the native library in the bindings (the build puts them) -----
/bindings/java/src/main/resources/natives/
/bindings/csharp/Beresta/runtimes/
/bindings/python/beresta/_native/
/bindings/node/native/

# ---- Результаты сборки обёрток / Binding build results ----------------------
# Java (Maven и самопроверка) / Java (Maven and the self-test)
/bindings/java/target/
# .NET
/bindings/csharp/**/bin/
/bindings/csharp/**/obj/
*.nupkg
*.snupkg
# Python
__pycache__/
*.py[cod]
*.egg-info/
/bindings/python/build/
/bindings/python/dist/
# Node.js (пакет npm pack и зависимости, если их поставили для экспериментов)
# Node.js (the npm pack package and dependencies, if installed for experiments)
/bindings/node/*.tgz
node_modules/

# ---- Объектные файлы, зависимости и бинарники (на случай сборки вне bin/) ---
# ---- Object files, dependencies and binaries (in case of a build outside bin/)
*.o
*.obj
*.d
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.node
*.out
*.app
*.pdb
*.ilk
*.exp
*.gch
*.pch
*.class
*.jar

# ---- Спецификации и рабочие документы / Specifications and working documents
dom_library_spec.txt
new_spec.txt
*_spec.txt
*_spec.md

# ---- Файлы IDE и редакторов / IDE and editor files --------------------------
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.swp
*~

# ---- Системный мусор ОС / OS system clutter ---------------------------------
.DS_Store
Thumbs.db
desktop.ini

# Сборка WebAssembly (make wasm) / The WebAssembly build (make wasm)
/bindings/wasm/dist/

# ---- Контекст для сессий Claude (локальный) / Context for Claude sessions (local)
/project_context.md
