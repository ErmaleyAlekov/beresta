# Словарь libFuzzer для целей «Берёсты»: лексемы XML, DTD, XPath и XSD.
# Мутатор вставляет их целиком — так фаззер быстрее доходит до глубоких
# веток разбора, чем побайтовым перебором.

# ---- Разделитель частей входа ----
separator="\xF5\xF5"

# ---- XML ----
"<?xml version=\"1.0\"?>"
" encoding=\"UTF-16\""
" encoding=\"ISO-8859-1\""
" encoding=\"windows-1251\""
" standalone=\"yes\""
"<?"
"?>"
"<!--"
"-->"
"<![CDATA["
"]]>"
"</"
"/>"
"&amp;"
"&lt;"
"&#x"
"&#"
"xmlns"
"xmlns:"
"xml:base"
"xml:space"
"xml:lang"
"\xEF\xBB\xBF"
"\xFE\xFF"
"\xFF\xFE"

# ---- DTD ----
"<!DOCTYPE"
"<!ENTITY"
"<!ENTITY %"
"<!ELEMENT"
"<!ATTLIST"
"<!NOTATION"
"<![INCLUDE["
"<![IGNORE["
"SYSTEM"
"PUBLIC"
"NDATA"
"#PCDATA"
"#REQUIRED"
"#IMPLIED"
"#FIXED"
"EMPTY"
"ANY"
"CDATA"
"IDREFS"
"ENTITIES"
"NMTOKENS"
"NOTATION"

# ---- XInclude ----
"xmlns:xi=\"http://www.w3.org/2001/XInclude\""
"<xi:include href=\"x\"/>"
"parse=\"text\""
"xpointer="
"<xi:fallback>"

# ---- XPath ----
"ancestor-or-self::"
"descendant::"
"following-sibling::"
"preceding::"
"namespace::"
"attribute::"
"node()"
"text()"
"comment()"
"processing-instruction("
"count("
"id("
"lang("
"substring("
"translate("
"normalize-space("
"concat("
"sum("
"round("
"string-length("
"local-name("
"namespace-uri("
"starts-with("
"contains("
" div "
" mod "
" and "
" or "
"//"
".."
"$all"
"!="
"<="

# ---- XSD ----
"<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\">"
"</xs:schema>"
"<xs:element name=\""
"<xs:complexType>"
"<xs:simpleType>"
"<xs:sequence>"
"<xs:choice>"
"<xs:all>"
"<xs:attribute name=\""
"<xs:restriction base=\"xs:"
"<xs:extension base=\""
"<xs:pattern value=\""
"<xs:enumeration value=\""
"<xs:key name=\""
"<xs:keyref name=\""
"<xs:unique name=\""
"<xs:selector xpath=\""
"<xs:field xpath=\""
"<xs:include schemaLocation=\""
"<xs:import namespace=\""
"<xs:any"
"<xs:list itemType=\""
"<xs:union memberTypes=\""
"minOccurs=\"0\""
"maxOccurs=\"unbounded\""
"targetNamespace=\""
"xsi:type=\""
"xsi:nil=\"true\""
"xs:dateTime"
"xs:decimal"
"xs:duration"
"xs:QName"
"\\p{L}"
"[a-z]{2,}"
